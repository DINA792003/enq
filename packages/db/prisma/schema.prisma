// DCT CRM - Enterprise Multi-Tenant CRM Platform
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANT & AUTH
// ============================================

model Tenant {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  companyCode String  @unique
  domain      String?
  logo        String?
  email       String?
  phone       String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  timezone    String?
  currency    String?
  description String?
  settings    Json?
  isActive    Boolean @default(true)

  companyStartDate  DateTime?
  companyExpiryDate DateTime?

  maxTotalUsers     Int       @default(10)
  maxAdminUsers     Int       @default(2)
  packageName       String?
  packageStatus     String    @default("active")
  packageStartDate  DateTime?
  packageExpiryDate DateTime?
  packageNotes      String?

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  roles                 Role[]
  profiles              Profile[]
  permissionSets        PermissionSet[]
  newPermissionSets     NewPermissionSet[]
  queues                Queue[]
  auditLogs             AuditLog[]
  reports               Report[]
  reportFolders         ReportFolder[]
  reportShares          ReportShare[]
  reportFavorites       ReportFavorite[]
  reportFolderShares    ReportFolderShare[]
  reportFolderFavorites ReportFolderFavorite[]
  dashboardFolders         DashboardFolder[]
  dashboardFolderFavorites DashboardFolderFavorite[]
  dashboards            Dashboard[]
  dashboardShares       DashboardShare[]
  dashboardFavorites    DashboardFavorite[]
  dashboardSubscriptions DashboardSubscription[]
  workflows             Workflow[]
  automations           Automation[]
  notifications         Notification[]
  leads                 Lead[]
  siteVisits            SiteVisit[]
  opportunities         Opportunity[]
  quotations            Quotation[]
  approvals             Approval[]
  bookings              Booking[]
  payments              Payment[]
  projects              Project[]
  units                 Unit[]
  tasks                 Task[]
  followUps             FollowUp[]
  activities            Activity[]
  aiConversations       AIConversation[]
  objectDefinitions     ObjectDefinition[]
  customRecords         CustomRecord[]
  permissionSetGroups   PermissionSetGroup[]
  objectSharingSettings ObjectSharingSetting[]
  sharingRules          SharingRule[]
  recordShares          RecordShare[]
  recordTeamMembers     RecordTeamMember[]
  leadOwnerHistories    LeadOwnerHistory[]
  sequences             Sequence[]
  rrQueues              RRQueue[]              @relation("RRQueueTenant")
  rrQueueMembers        RRQueueMember[]        @relation("RRQueueMemberTenant")
  rrQueueHistory        RRQueueHistory[]       @relation("RRQueueHistoryTenant")

  @@index([slug])
  @@index([companyCode])
}

model User {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  email                String
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  avatar               String?
  isActive             Boolean   @default(true)
  isSuperAdmin         Boolean   @default(false)
  profileId            String?
  profile              Profile?  @relation(fields: [profileId], references: [id])
  lastLoginAt          DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  roles                    UserRole[]
  ownedDashboards          Dashboard[]                @relation("DashboardOwner")
  dashboardShares          DashboardShare[]
  dashboardFavorites       DashboardFavorite[]
  dashboardFolderFavorites DashboardFolderFavorite[]
  dashboardSubscriptions   DashboardSubscription[]
  roleId                   String?
  role                     Role?                      @relation("UserPrimaryRole", fields: [roleId], references: [id])
  assignedLeads            Lead[]                     @relation("LeadOwner")
  createdLeads             Lead[]                     @relation("LeadCreator")
  assignedOpportunities    Opportunity[]              @relation("OppOwner")
  createdOpportunities     Opportunity[]              @relation("OppCreator")
  assignedSiteVisits       SiteVisit[]                @relation("SvAssignee")
  createdSiteVisits        SiteVisit[]                @relation("SvCreator")
  completedSiteVisits      SiteVisit[]                @relation("SvCompletedBy")
  cancelledSiteVisits      SiteVisit[]                @relation("SvCancelledBy")
  assignedBookings         Booking[]                  @relation("BookingOwner")
  createdBookings          Booking[]                  @relation("BookingCreator")
  tasks                    Task[]
  followUps                FollowUp[]
  activities               Activity[]
  aiConversations          AIConversation[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  ownedCustomRecords       CustomRecord[]
  permissionSetAssignments UserPermissionAssignment[]
  directPermissions        UserDirectPermission[]
  permissionSetGroups      UserPermissionSetGroup[]
  recordShares             RecordShare[]
  teamMemberships          RecordTeamMember[]
  prevLeadOwnerHistory     LeadOwnerHistory[]         @relation("PrevLeadOwner")
  newLeadOwnerHistory      LeadOwnerHistory[]         @relation("NewLeadOwner")
  leadHistoryChanges       LeadOwnerHistory[]
  ownedRRQueues             RRQueue[]             @relation("RRQueueOwner")
  createdRRQueues           RRQueue[]             @relation("RRQueueCreatedBy")
  updatedRRQueues           RRQueue[]             @relation("RRQueueUpdatedBy")
  rrQueueMembers            RRQueueMember[]       @relation("RRQueueMemberUser")
  rrQueueHistoryEntries     RRQueueHistory[]      @relation("RRQueueHistoryUser")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            UserRole[]
  dashboardShares  DashboardShare[]
  primaryUsers     User[]              @relation("UserPrimaryRole")
  parentRoleId     String?
  parentRole       Role?               @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles       Role[]              @relation("RoleHierarchy")
  permissionSets   PermissionSetRole[]
  objectPerms      ObjectPermission[]
  fieldPerms       FieldPermission[]
  sharingRulesFrom SharingRule[]       @relation("SharingRuleFromRole")
  sharingRulesTo   SharingRule[]       @relation("SharingRuleToRole")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Profile {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  name             String
  description      String?
  isDefault        Boolean  @default(false)
  isAdmin          Boolean  @default(false)
  leadStatusAccess Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users              User[]
  permissionSets     PermissionSet[]
  profilePermissions UserProfilePermission[]
  objectPermissions  ProfileObjectPermission[]
  fieldPermissions   ProfileFieldPermission[]
  dashboardShares    DashboardProfileShare[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PermissionSet {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id])
  name        String
  description String?
  objectName  String
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles PermissionSetRole[]

  @@unique([tenantId, profileId, objectName])
  @@index([tenantId])
  @@index([objectName])
}

model PermissionSetRole {
  id              String        @id @default(cuid())
  permissionSetId String
  permissionSet   PermissionSet @relation(fields: [permissionSetId], references: [id])
  roleId          String
  role            Role          @relation(fields: [roleId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([permissionSetId, roleId])
}

// ============================================
// EFFECTIVE PERMISSION SYSTEM
// ============================================

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  module      String
  action      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profilePermissions    UserProfilePermission[]
  permSetItems          NewPermissionSetItem[]
  directUserPermissions UserDirectPermission[]

  @@index([module])
  @@index([module, action])
}

model NewPermissionSet {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items             NewPermissionSetItem[]
  userAssignments   UserPermissionAssignment[]
  objectPermissions PermissionSetObjectPermission[]
  fieldPermissions  PermissionSetFieldPermission[]
  groupItems        PermissionSetGroupItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model NewPermissionSetItem {
  id              String           @id @default(cuid())
  permissionSetId String
  permissionSet   NewPermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  permissionId    String
  permission      Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@unique([permissionSetId, permissionId])
  @@index([permissionSetId])
  @@index([permissionId])
}

model UserProfilePermission {
  id           String     @id @default(cuid())
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([profileId, permissionId])
  @@index([profileId])
  @@index([permissionId])
}

model UserPermissionAssignment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionSetId String
  permissionSet   NewPermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@unique([userId, permissionSetId])
  @@index([userId])
  @@index([permissionSetId])
}

model UserDirectPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model ProfileObjectPermission {
  id        String           @id @default(cuid())
  tenantId  String
  profileId String
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  objectId  String
  object    ObjectDefinition @relation(fields: [objectId], references: [id], onDelete: Cascade)
  canCreate Boolean          @default(false)
  canRead   Boolean          @default(false)
  canUpdate Boolean          @default(false)
  canDelete Boolean          @default(false)
  viewAll   Boolean          @default(false)
  modifyAll Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([profileId, objectId])
  @@index([tenantId])
  @@index([profileId])
  @@index([objectId])
}

model ProfileFieldPermission {
  id        String          @id @default(cuid())
  tenantId  String
  profileId String
  profile   Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fieldId   String
  field     FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  canRead   Boolean         @default(true)
  canEdit   Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([profileId, fieldId])
  @@index([tenantId])
  @@index([profileId])
  @@index([fieldId])
}

model PermissionSetObjectPermission {
  id              String           @id @default(cuid())
  permissionSetId String
  permissionSet   NewPermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  objectId        String
  object          ObjectDefinition @relation(fields: [objectId], references: [id], onDelete: Cascade)
  canCreate       Boolean          @default(false)
  canRead         Boolean          @default(false)
  canUpdate       Boolean          @default(false)
  canDelete       Boolean          @default(false)
  viewAll         Boolean          @default(false)
  modifyAll       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([permissionSetId, objectId])
  @@index([permissionSetId])
  @@index([objectId])
}

model PermissionSetFieldPermission {
  id              String           @id @default(cuid())
  permissionSetId String
  permissionSet   NewPermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  fieldId         String
  field           FieldDefinition  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  canRead         Boolean          @default(true)
  canEdit         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([permissionSetId, fieldId])
  @@index([permissionSetId])
  @@index([fieldId])
}

model PermissionSetGroup {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean                  @default(true)
  assignments PermissionSetGroupItem[]
  users       UserPermissionSetGroup[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PermissionSetGroupItem {
  id              String             @id @default(cuid())
  groupId         String
  group           PermissionSetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissionSetId String
  permissionSet   NewPermissionSet   @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  @@unique([groupId, permissionSetId])
  @@index([groupId])
  @@index([permissionSetId])
}

model UserPermissionSetGroup {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     PermissionSetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Queue {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  type        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads         Lead[]
  opportunities Opportunity[]
  siteVisits    SiteVisit[]
  bookings      Booking[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

enum SharingModel {
  PRIVATE
  PUBLIC_READ_ONLY
  PUBLIC_READ_WRITE
}

enum SharingAccessLevel {
  READ
  EDIT
}

model ObjectSharingSetting {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objectId     String
  object       ObjectDefinition @relation(fields: [objectId], references: [id], onDelete: Cascade)
  sharingModel SharingModel     @default(PRIVATE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tenantId, objectId])
  @@index([tenantId])
  @@index([objectId])
}

model SharingRule {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  objectName  String
  fromRoleId  String?
  fromRole    Role?              @relation("SharingRuleFromRole", fields: [fromRoleId], references: [id])
  toRoleId    String?
  toRole      Role?              @relation("SharingRuleToRole", fields: [toRoleId], references: [id])
  accessLevel SharingAccessLevel @default(READ)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([objectName])
  @@index([fromRoleId])
  @@index([toRoleId])
}

model RecordShare {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectName  String
  recordId    String
  accessLevel SharingAccessLevel @default(READ)
  reason      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, objectName, recordId])
  @@index([tenantId, objectName, recordId])
  @@index([userId])
}

model RecordTeamMember {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectName  String
  recordId    String
  role        String?
  accessLevel SharingAccessLevel @default(READ)
  createdAt   DateTime           @default(now())

  @@unique([userId, objectName, recordId])
  @@index([tenantId, objectName, recordId])
  @@index([userId])
}

// ============================================
// CRM CORE
// ============================================

enum LeadStatus {
  NEW
  INCOMING
  PROSPECT
  SITE_VISIT_SCHEDULED
  SITE_VISIT_HAPPENED
  BOOKED
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  ADVERTISEMENT
  WALK_IN
  PORTAL
  INSTAGRAM
  TWITTER
  WHATSAPP
  YOUTUBE
  OTHER
}

enum Salutation {
  MR
  MS
  MRS
  DR
  PROF
}

enum Industry {
  TECHNOLOGY
  HEALTHCARE
  FINANCE
  EDUCATION
  MANUFACTURING
  RETAIL
  REAL_ESTATE
  CONSTRUCTION
  HOSPITALITY
  AUTOMOTIVE
  ENERGY
  TELECOMMUNICATIONS
  MEDIA
  GOVERNMENT
  OTHER
}

enum Rating {
  HOT
  WARM
  COLD
}

model Lead {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  ownerId    String?
  owner      User?    @relation("LeadOwner", fields: [ownerId], references: [id])
  creatorId  String
  creator    User     @relation("LeadCreator", fields: [creatorId], references: [id])
  leadNumber String?
  rrQueueId  String?
  rrQueue    RRQueue? @relation(fields: [rrQueueId], references: [id])
  queueId    String?
  queue      Queue?   @relation(fields: [queueId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])

  // Standard Lead Fields - Contact Information
  salutation Salutation?
  firstName  String?
  lastName   String
  title      String?
  email      String?
  phone      String?
  mobile     String?
  website    String?

  // Standard Lead Fields - Company Information
  company           String
  industry          Industry?
  annualRevenue     Float?
  numberOfEmployees Int?

  // Standard Lead Fields - Lead Management
  source       LeadSource @default(OTHER)
  status       LeadStatus @default(NEW)
  rating       Rating?
  description  String?
  score        Int        @default(0)
  budget       Float?
  requirements String?
  notes        String?

  // Standard Lead Fields - Address
  street        String?
  city          String?
  stateProvince String?
  country       String?
  postalCode    String?

  // Duplicate detection
  duplicateOfId String?
  duplicateOf   Lead?   @relation("LeadDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    Lead[]  @relation("LeadDuplicates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteVisits    SiteVisit[]
  opportunities Opportunity[]
  quotations    Quotation[]
  bookings      Booking[]
  tasks         Task[]
  followUps     FollowUp[]
  activities    Activity[]
  auditLogs     AuditLog[]
  ownerHistory  LeadOwnerHistory[]
  rrAssignmentHistory RRQueueHistory[]

  @@unique([tenantId, phone])
  @@unique([tenantId, leadNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([tenantId, email])
  @@index([tenantId, company])
  @@index([tenantId, source])
  @@index([tenantId, createdAt])
}

// ============================================
// SITE VISITS
// ============================================

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model SiteVisit {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  assigneeId String?
  assignee   User?    @relation("SvAssignee", fields: [assigneeId], references: [id])
  creatorId  String
  creator    User     @relation("SvCreator", fields: [creatorId], references: [id])
  queueId    String?
  queue      Queue?   @relation(fields: [queueId], references: [id])

  siteVisitNumber String

  previousSiteVisitId String?
  previousSiteVisit   SiteVisit?  @relation("SiteVisitRevisit", fields: [previousSiteVisitId], references: [id])
  revisits            SiteVisit[] @relation("SiteVisitRevisit")

  scheduledAt        DateTime
  completedAt        DateTime?
  completedById      String?
  completedBy        User?           @relation("SvCompletedBy", fields: [completedById], references: [id])
  status             SiteVisitStatus @default(SCHEDULED)
  feedback           String?
  customerFeedback   String?
  completionNotes    String?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?           @relation("SvCancelledBy", fields: [cancelledById], references: [id])
  rating             Int?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  activities    Activity[]
  tasks         Task[]
  opportunities Opportunity[]

  @@unique([tenantId, siteVisitNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([leadId])
  @@index([previousSiteVisitId])
}

// ============================================
// SALES & OPPORTUNITIES
// ============================================

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Opportunity {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id])
  ownerId     String?
  owner       User?      @relation("OppOwner", fields: [ownerId], references: [id])
  creatorId   String
  creator     User       @relation("OppCreator", fields: [creatorId], references: [id])
  queueId     String?
  queue       Queue?     @relation(fields: [queueId], references: [id])
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  unitId      String?
  unit        Unit?      @relation(fields: [unitId], references: [id])
  siteVisitId String?
  siteVisit   SiteVisit? @relation(fields: [siteVisitId], references: [id])

  opportunityNumber String?
  name              String
  stage             OpportunityStage @default(PROSPECTING)
  amount            Float?
  expectedCloseDate DateTime?
  probability       Int?
  description       String?
  lostReason        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  quotations Quotation[]
  bookings   Booking[]
  activities Activity[]
  tasks      Task[]
  auditLogs  AuditLog[]

  @@unique([tenantId, opportunityNumber])
  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, ownerId])
  @@index([leadId])
}

// ============================================
// QUOTATIONS & APPROVALS
// ============================================

enum QuotationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

model Quotation {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])

  number      String
  status      QuotationStatus @default(DRAFT)
  totalAmount Float
  taxAmount   Float?
  discount    Float?
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items     QuotationItem[]
  approvals Approval[]
  bookings  Booking[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([leadId])
  @@index([opportunityId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id])
  description String
  quantity    Int       @default(1)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quotationId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  quotationId String
  quotation   Quotation      @relation(fields: [quotationId], references: [id])
  approverId  String
  status      ApprovalStatus @default(PENDING)
  comments    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId])
  @@index([quotationId])
  @@index([approverId])
}

// ============================================
// BOOKINGS & FINANCE
// ============================================

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  quotationId   String?
  quotation     Quotation?   @relation(fields: [quotationId], references: [id])
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id])
  unitId        String
  unit          Unit         @relation(fields: [unitId], references: [id])
  ownerId       String?
  owner         User?        @relation("BookingOwner", fields: [ownerId], references: [id])
  creatorId     String
  creator       User         @relation("BookingCreator", fields: [creatorId], references: [id])
  queueId       String?
  queue         Queue?       @relation(fields: [queueId], references: [id])

  number      String
  status      BookingStatus @default(PENDING)
  bookingDate DateTime      @default(now())
  totalAmount Float
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments   Payment[]
  activities Activity[]
  auditLogs  AuditLog[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@index([leadId])
  @@index([unitId])
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  PARTIAL
  COMPLETED
}

model Payment {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount      Float
  status      PaymentStatus @default(PENDING)
  paymentDate DateTime      @default(now())
  reference   String?
  notes       String?
  verifiedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([bookingId])
}

// ============================================
// PROJECTS & UNITS
// ============================================

enum UnitStatus {
  AVAILABLE
  HOLD
  RESERVED
  BOOKED
  SOLD
  BLOCKED
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  latitude    Float?
  longitude   Float?
  totalUnits  Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units         Unit[]
  leads         Lead[]
  siteVisits    SiteVisit[]
  opportunities Opportunity[]
  quotations    Quotation[]
  bookings      Booking[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Unit {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  number    String
  type      String?
  floor     Int?
  area      Float?
  price     Float?
  status    UnitStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  quotationItems QuotationItem[]
  bookings       Booking[]
  opportunities  Opportunity[]

  @@unique([tenantId, projectId, number])
  @@index([tenantId])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

// ============================================
// WORK MANAGEMENT
// ============================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  siteVisitId   String?
  siteVisit     SiteVisit?   @relation(fields: [siteVisitId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id])

  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@index([tenantId, status])
  @@index([leadId])
}

model FollowUp {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id])
  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id])

  title       String
  description String?
  dueDate     DateTime
  completedAt DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@index([leadId])
}

// ============================================
// ACTIVITIES & NOTIFICATIONS
// ============================================

enum ActivityType {
  CALL
  MEETING
  WHATSAPP
  EMAIL
  SITE_VISIT
  NOTE
  TASK
  FOLLOW_UP
  SYSTEM
}

model Activity {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  siteVisitId   String?
  siteVisit     SiteVisit?   @relation(fields: [siteVisitId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  bookingId     String?
  booking       Booking?     @relation(fields: [bookingId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])

  type        ActivityType
  subject     String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([leadId])
  @@index([siteVisitId])
  @@index([opportunityId])
  @@index([bookingId])
}

model Notification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  title         String
  message       String
  type          String
  referenceId   String?
  referenceType String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, userId, isRead])
}

// ============================================
// WORKFLOWS & AUTOMATIONS
// ============================================

model Workflow {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  description   String?
  triggerType   String
  triggerObject String
  conditions    Json
  actions       Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Automation {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  description  String?
  triggerEvent String
  conditions   Json
  actions      Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ============================================
// REPORTS & DASHBOARDS
// ============================================

enum ReportVisibility {
  PRIVATE
  PUBLIC
  SHARED
}

enum DashboardVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

model ReportFolder {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  visibility  ReportVisibility @default(PRIVATE)
  isShared    Boolean          @default(false)
  deletedAt   DateTime?
  modifiedBy  String?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reports   Report[]
  favorites ReportFolderFavorite[]
  shares    ReportFolderShare[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Report {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  folderId    String?
  folder      ReportFolder? @relation(fields: [folderId], references: [id])
  name        String
  description String?
  type        String
  objectName  String
  columns     Json
  config      Json?
  filters     Json?
  groupBy     String?
  sortBy      String?
  isShared    Boolean       @default(false)
  deletedAt   DateTime?
  modifiedBy  String?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  favorites ReportFavorite[]
  shares    ReportShare[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([folderId])
}

model ReportShare {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId      String?
  roleId      String?
  accessLevel String   @default("VIEWER")
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([tenantId, reportId])
  @@index([userId])
  @@index([roleId])
}

model ReportFavorite {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([tenantId, userId])
}

model ReportFolderShare {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  folderId    String
  folder      ReportFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId      String?
  roleId      String?
  accessLevel String       @default("VIEWER")
  createdBy   String
  createdAt   DateTime     @default(now())

  @@index([tenantId, folderId])
  @@index([userId])
  @@index([roleId])
}

model ReportFolderFavorite {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  folderId  String
  folder    ReportFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime     @default(now())

  @@unique([folderId, userId])
  @@index([tenantId, userId])
}

model Dashboard {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  folderId    String?
  folder      DashboardFolder? @relation(fields: [folderId], references: [id])
  ownerId     String?
  owner       User? @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name        String
  description String?
  filters     Json?
  layout      Json
  layoutConfig Json?
  visibility  DashboardVisibility @default(PRIVATE)
  refreshInterval String @default("MANUAL")
  autoRefreshWhileEditing Boolean @default(false)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdBy   String
  lastRefreshedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sharedProfiles DashboardProfileShare[]
  shares        DashboardShare[]
  favorites     DashboardFavorite[]
  subscriptions DashboardSubscription[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([folderId])
  @@index([ownerId])
}

model DashboardProfileShare {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, profileId])
  @@index([profileId])
}

model DashboardFolder {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dashboards Dashboard[]
  favorites  DashboardFolderFavorite[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model DashboardFolderFavorite {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  folderId  String
  folder    DashboardFolder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([folderId, userId])
  @@index([tenantId, userId])
}

model DashboardShare {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String?
  user        User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String?
  role        Role? @relation(fields: [roleId], references: [id], onDelete: Cascade)
  teamId      String?
  accessLevel String   @default("VIEW")
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([tenantId, dashboardId])
  @@index([userId])
  @@index([roleId])
}

model DashboardFavorite {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([dashboardId, userId])
  @@index([tenantId, userId])
}

model DashboardSubscription {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([dashboardId, userId])
  @@index([tenantId, userId])
}

// ============================================
// AUDIT & AI
// ============================================

model AuditLog {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  bookingId     String?
  booking       Booking?     @relation(fields: [bookingId], references: [id])

  action     String
  objectType String
  objectId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, objectType])
  @@index([tenantId, createdAt])
  @@index([tenantId, objectType, objectId])
  @@index([createdAt])
}

model AIConversation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@index([tenantId, userId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id])

  role        String
  content     String
  toolCalls   Json?
  toolResults Json?
  createdAt   DateTime @default(now())

  @@index([conversationId])
}

// ============================================
// METADATA - OBJECT DEFINITIONS
// ============================================

model ObjectDefinition {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name                    String
  label                   String
  pluralLabel             String
  description             String?
  icon                    String?
  objectType              String  @default("custom")
  isActive                Boolean @default(true)
  isAvailableInNavigation Boolean @default(true)
  isAvailableInReports    Boolean @default(true)

  createdBy String
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  fields                         FieldDefinition[]
  layouts                        PageLayout[]
  objectPerms                    ObjectPermission[]
  profileObjectPermissions       ProfileObjectPermission[]
  permissionSetObjectPermissions PermissionSetObjectPermission[]
  sharingSettings                ObjectSharingSetting[]
  records                        CustomRecord[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ============================================
// METADATA - FIELD DEFINITIONS
// ============================================

model FieldDefinition {
  id       String           @id @default(cuid())
  tenantId String
  objectId String
  object   ObjectDefinition @relation(fields: [objectId], references: [id], onDelete: Cascade)

  name        String
  label       String
  fieldType   String
  description String?
  helpText    String?

  required     Boolean @default(false)
  unique       Boolean @default(false)
  defaultValue String?

  searchable Boolean @default(false)
  sortable   Boolean @default(false)
  filterable Boolean @default(false)

  visible         Boolean @default(true)
  editable        Boolean @default(true)
  isActive        Boolean @default(true)
  isSystemField   Boolean @default(false)
  isCustomField   Boolean @default(true)
  isStandardField Boolean @default(false)

  displayOrder Int @default(0)

  minLength Int?
  maxLength Int?
  minValue  Float?
  maxValue  Float?
  precision Int?
  scale     Int?

  lookupObject String?
  lookupField  String?

  validationRules Json?

  createdBy String
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  picklistValues                PicklistValue[]
  fieldPerms                    FieldPermission[]
  profileFieldPermissions       ProfileFieldPermission[]
  permissionSetFieldPermissions PermissionSetFieldPermission[]

  @@unique([objectId, name])
  @@index([objectId])
  @@index([tenantId])
}

// ============================================
// METADATA - PICKLIST VALUES
// ============================================

model PicklistValue {
  id       String          @id @default(cuid())
  tenantId String
  fieldId  String
  field    FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  label        String
  value        String
  isActive     Boolean @default(true)
  isDefault    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([fieldId, value])
  @@index([fieldId])
}

// ============================================
// METADATA - PAGE LAYOUTS
// ============================================

model PageLayout {
  id       String           @id @default(cuid())
  tenantId String
  objectId String
  object   ObjectDefinition @relation(fields: [objectId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)
  sections  Json

  createdBy String
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([objectId, name])
  @@index([objectId])
}

// ============================================
// PERMISSIONS - OBJECT LEVEL
// ============================================

model ObjectPermission {
  id       String           @id @default(cuid())
  tenantId String
  roleId   String
  role     Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  objectId String
  object   ObjectDefinition @relation(fields: [objectId], references: [id], onDelete: Cascade)

  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  viewAll   Boolean @default(false)
  modifyAll Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, objectId])
  @@index([roleId])
  @@index([objectId])
}

// ============================================
// PERMISSIONS - FIELD LEVEL
// ============================================

model FieldPermission {
  id       String          @id @default(cuid())
  tenantId String
  roleId   String
  role     Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  fieldId  String
  field    FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  canRead Boolean @default(true)
  canEdit Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, fieldId])
  @@index([roleId])
  @@index([fieldId])
}

// ============================================
// CUSTOM OBJECT RECORDS
// ============================================

model CustomRecord {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  objectId String
  object   ObjectDefinition @relation(fields: [objectId], references: [id], onDelete: Cascade)

  recordNumber String?
  ownerId      String?
  owner        User?   @relation(fields: [ownerId], references: [id])

  data     Json
  isActive Boolean @default(true)

  createdBy String
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([tenantId, objectId, recordNumber])
  @@index([tenantId, objectId])
  @@index([tenantId, ownerId])
  @@index([objectId])
}

// ============================================
// SEQUENCES
// ============================================

model Sequence {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  type      String
  nextValue Int    @default(1)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model RRQueue {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation("RRQueueTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  leadStatus         Json?
  leadSource         Json?
  secondarySource    Json?
  tertiarySource     Json?
  leadPriority       Json?
  category           Json?
  projectInterested  Json?
  country            Json?
  presalesQueue      Boolean   @default(false)
  excludeFromNoSource Json?
  active             Boolean   @default(true)
  startTime          DateTime?
  endTime            DateTime?
  ownerId            String?
  defaultOwnerId     String?
  owner              User?     @relation("RRQueueOwner", fields: [ownerId], references: [id])
  leadCount          Int       @default(0)
  previousId         Int       @default(0)
  noOfUsers          Int       @default(0)
  createdById        String
  createdBy          User      @relation("RRQueueCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedById        String?
  updatedBy          User?     @relation("RRQueueUpdatedBy", fields: [updatedById], references: [id])
  updatedAt          DateTime  @updatedAt

  members            RRQueueMember[]
  history            RRQueueHistory[]
  leads              Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, ownerId])
}

model RRQueueMember {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation("RRQueueMemberTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  rrQueueId        String
  rrQueue          RRQueue  @relation(fields: [rrQueueId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation("RRQueueMemberUser", fields: [userId], references: [id])
  userIdNumber     Decimal? @db.Decimal(18, 0)
  sequenceId       Int
  activeMember     Boolean  @default(true)
  maxLeadCapacity  Int      @default(-1)
  currentLeadCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, name], map: "RRQueueMember_tenant_name_key")
  @@unique([rrQueueId, userId])
  @@unique([rrQueueId, sequenceId])
  @@index([tenantId, rrQueueId, activeMember])
}

model RRQueueHistory {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation("RRQueueHistoryTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  rrQueueId    String
  rrQueue      RRQueue  @relation(fields: [rrQueueId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  field        String
  userId       String
  user         User     @relation("RRQueueHistoryUser", fields: [userId], references: [id])
  userName     String
  originalValue String?
  newValue     String?
  createdAt    DateTime @default(now())

  @@index([tenantId, rrQueueId, createdAt])
  @@index([leadId])
}

// ============================================
// LEAD OWNER HISTORY
// ============================================

model LeadOwnerHistory {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousOwnerId String?
  previousOwner   User?     @relation("PrevLeadOwner", fields: [previousOwnerId], references: [id])
  newOwnerId      String?
  newOwner        User?     @relation("NewLeadOwner", fields: [newOwnerId], references: [id])
  previousProfile String?
  newProfile      String?
  previousStatus  String?
  newStatus       String?
  handoffReason   String?
  changedById     String
  changedBy       User      @relation(fields: [changedById], references: [id])
  startDate       DateTime  @default(now())
  endDate         DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([leadId])
  @@index([newOwnerId])
  @@index([previousOwnerId])
  @@index([tenantId, leadId])
  @@index([leadId, endDate])
}
